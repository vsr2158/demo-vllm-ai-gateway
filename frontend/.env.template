# Copy to .env and fill in. .env is gitignored.
#
# Base URL of the LiteLLM gateway (ALB DNS, no trailing slash).
LITELLM_BASE_URL=http://genai-gateway-alb-569044484.ap-southeast-2.elb.amazonaws.com

# API key used by the demo. For the demo this is the LiteLLM master key, but you
# can swap in a scoped virtual key (generate one in the Admin UI at /ui ->
# "Virtual Keys" -> + Create New Key) without touching code.
LITELLM_API_KEY=sk-your-key-here
